# ============================================================
#  ONE ENV FILE FOR EVERYTHING (Template)
# ============================================================

# --- BACKEND (MongoDB & Cloudinary) ---
MONGO_URI=your_mongodb_connection_string
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
JWT_SECRET=your_jwt_secret_key

# --- FRONTEND (Vite) ---
# Leave blank to use Netlify serverless functions on the same domain
VITE_REACT_APP_BACKEND_BASEURL=
VITE_REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_REACT_APP_CLOUDINARY_API_KEY=your_cloudinary_api_key
